aws_region = "ap-south-1"
project_name = "homaid"
environment = "production"
github_repository = "S-charan120/homaid-aws-ecs"
# Immutable IDs from GitHub repository metadata (do not substitute display names).
github_repository_owner_id = "133835940"
github_repository_id = "1448338738"
# Must exactly match the deploy job's environment in .github/workflows/ci.yml.
github_actions_environment = "aws-production"
# Create/reuse the GitHub OIDC provider in this AWS account.
create_github_oidc_provider = true
# If reusing a provider, set its ARN and set create_github_oidc_provider = false.
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
desired_count = 2
task_cpu = 512
task_memory = 1024
# Public HTTPS is mandatory: use a Route 53 zone and an ISSUED ACM certificate
# in the same AWS region as the ALB, covering this exact hostname.
domain_name = "book.example.com"
hosted_zone_id = "Z0123456789EXAMPLE"
acm_certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
